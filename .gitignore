# goal ledger (hive store, never commit)
/.goal/

# IDE
.idea/

# Dart / Flutter build artifacts
/.dart_tool/
# pub-get artifacts inside test corpora (machine-specific absolute paths);
# hand-materialized resolution artifacts are load-bearing and tracked
# (same principle as the plugin-validation package configs below)
tests/corpus/*/.dart_tool/*
# real-corpus sweep materialization (scripts/real-corpus-sweep.sh): one
# .dart_tool per package under tests/corpus/real/, regenerated per run —
# pub-get configs carry machine-specific absolute cache paths
tests/corpus/real/*/.dart_tool/
tests/corpus/real/*/pubspec.lock
!tests/corpus/lints-new/.dart_tool/package_config.json
!tests/corpus/nested-versions/.dart_tool/package_config.json
!tests/corpus/nested-versions/.dart_tool/pub/
tests/corpus/nested-versions/.dart_tool/pub/*
!tests/corpus/nested-versions/.dart_tool/pub/workspace_ref.json
# the pub-* corpora carry hand-authored package_config.json fixtures that ARE
# the input under test (pub-corrupt-config's is deliberately truncated
# mid-entry; pub-nested-example's are pinned below the language-version
# floor). They cannot be regenerated by pub get, so they are tracked.
!tests/corpus/pub-corrupt-config/.dart_tool/package_config.json
!tests/corpus/pub-nested-example/.dart_tool/package_config.json
!tests/corpus/pub-null-sections/.dart_tool/package_config.json
!tests/corpus/pub-universe-shadow/.dart_tool/package_config.json
# generated mega-corpus output (corpus-gen serial phase)
tests/corpus/mega/
# generated flutter-app corpus output (app-gate, #2063)
tests/corpus/app/
# test-face parity fixtures (test-face-matrix workflow +
# scripts/test-face-parity.sh): pub-get artifacts, the dartq probe/recipe
# trees and the tool's build outputs are regenerated per matrix job
tests/testface/*/.dart_tool/
tests/testface/*/pubspec.lock
build/
*.iml

# Melos
.melos_tool/

# macOS
.DS_Store

# Python generator bytecode (tests/corpus/*/generate.py, torture/tools/)
__pycache__/

# Rust build artifacts
/target
crates/dartq-plugin-host/.dart_tool/
crates/dartq-plugin-host/samples/*/.dart_tool/
crates/dartq-plugin-host/pubspec.lock

# third-party plugin fixture: the injected per-plugin package configs are
# tracked (they are load-bearing — the shim/host mapping is not a pub
# dependency); pub-get artifacts and A-B run outputs around them are not
tests/plugin-validation/presets/*/.dart_tool/
tests/plugin-validation/presets/*/pubspec.lock
# A-B arm lib/ is materialized from corpora/ by scripts/plugin-ab.sh (serial phase)
tests/plugin-validation/presets/*/lib/
tests/plugin-validation/vendor/*/pubspec.lock
tests/plugin-validation/vendor/*/.dart_tool/*
!tests/plugin-validation/vendor/*/.dart_tool/package_config.json
# parity workspace pub-get artifacts: unlike vendor/, the parity
# package_config is a plain pub-get output carrying machine-specific
# absolute rootUris (not load-bearing — regenerated by the serial-phase
# harness), so the whole .dart_tool and the lock stay untracked
tests/plugin-validation/parity/*/.dart_tool/
tests/plugin-validation/parity/*/pubspec.lock
tests/plugin-validation/results/
# census expectations are per-run generated ground truth (deterministic
# format, scripts/plugin-census.sh); plugin-parity.sh exits 2 with the
# remedy when a filter file is absent — regeneration is the recovery
tests/plugin-validation/expectations/

# mega-x regenerated scale trees (slice/ is the tracked golden slice;
# glob the children so the negation can re-include them)
tests/corpus/mega-x/*
!tests/corpus/mega-x/slice/
